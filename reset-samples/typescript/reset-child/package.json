{
  "name": "reset-child-typescript-example",
  "version": "1.0.0",
  "description": "Temporal child workflows with reset points - Financial Research example in TypeScript",
  "main": "lib/worker.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node lib/worker.js",
    "start.watch": "nodemon src/worker.ts",
    "worker": "npm run build && node lib/worker.js",
    "workflow": "npm run build && node lib/client.js"
  },
  "keywords": [
    "temporal",
    "workflow",
    "reset-points",
    "child-workflows",
    "financial-research"
  ],
  "dependencies": {
    "@temporalio/activity": "^1.11.4",
    "@temporalio/client": "^1.11.4",
    "@temporalio/worker": "^1.11.4",
    "@temporalio/workflow": "^1.11.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}




